{
  "name": "puzzle-poc",
  "workspaces": [
    "./frontend"
  ],
  "devDependencies": {
    "@biomejs/biome": "^2.6.6"
  },
  "scripts": {
    "test": "node --experimental-strip-types --test frontend/tests/*.test.ts",
    "dev": "bun --filter puzzle-app dev",
    "build": "bun --filter puzzle-app build",
    "preview": "bun --filter puzzle-app preview",
    "lint": "biome lint frontend/src frontend/vite.config.ts",
    "format": "biome format --write frontend/src frontend/vite.config.ts"
  },
  "packageManager": "bun@1.4.4",
  "private": true
}
